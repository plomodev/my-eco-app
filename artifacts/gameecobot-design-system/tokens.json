{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "GameEcoBot tokens mapped from the dark violet WinForms UI in plomodev/my-eco-app. Dark values are source-mapped; light values are derived because the source has no light theme. Edit this file only; generated theme files are rebuilt by scripts/build-tokens.mjs.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f5f2fb" },
      "foreground": { "$value": "#17112c" },
      "border": { "$value": "#d9d0e7" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#17112c" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#17112c" },
      "primary": {
        "$value": "#6d28d9",
        "$description": "Primary violet mapped from the source app's #7c3aed button treatment and darkened for readable light-mode contrast."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#eee8f7" },
      "secondaryForeground": { "$value": "#30264a" },
      "muted": { "$value": "#eee9f5" },
      "mutedForeground": { "$value": "#655a7a" },
      "accent": { "$value": "#f0e4ff" },
      "accentForeground": { "$value": "#54249a" },
      "destructive": { "$value": "#be123c" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#cec3df" },
      "ring": { "$value": "#7c3aed" },
      "chart1": { "$value": "#6d28d9" },
      "chart2": { "$value": "#9333ea" },
      "chart3": { "$value": "#a855f7" },
      "chart4": { "$value": "#c084fc" },
      "chart5": { "$value": "#4f46e5" },
      "sidebar": { "$value": "#f1edfa" },
      "sidebarForeground": { "$value": "#30264a" },
      "sidebarBorder": { "$value": "#d9d0e7" },
      "sidebarPrimary": { "$value": "#6d28d9" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#e8def5" },
      "sidebarAccentForeground": { "$value": "#30264a" },
      "sidebarRing": { "$value": "#7c3aed" }
    },
    "dark": {
      "background": { "$value": "#0c0a18" },
      "foreground": { "$value": "#f5f3ff" },
      "border": { "$value": "#3c3069" },
      "card": { "$value": "#16112c" },
      "cardForeground": { "$value": "#f5f3ff" },
      "popover": { "$value": "#130f24" },
      "popoverForeground": { "$value": "#f5f3ff" },
      "primary": { "$value": "#7c3aed" },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#241b3a" },
      "secondaryForeground": { "$value": "#eee8ff" },
      "muted": { "$value": "#211a35" },
      "mutedForeground": { "$value": "#b5a8d3" },
      "accent": { "$value": "#a855f7" },
      "accentForeground": { "$value": "#ffffff" },
      "destructive": { "$value": "#e11d48" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#342a5a" },
      "ring": { "$value": "#c084fc" },
      "chart1": { "$value": "#7c3aed" },
      "chart2": { "$value": "#a855f7" },
      "chart3": { "$value": "#c084fc" },
      "chart4": { "$value": "#d8b4fe" },
      "chart5": { "$value": "#6d28d9" },
      "sidebar": { "$value": "#0a0812" },
      "sidebarForeground": { "$value": "#f5f3ff" },
      "sidebarBorder": { "$value": "#282040" },
      "sidebarPrimary": { "$value": "#7c3aed" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#1c1530" },
      "sidebarAccentForeground": { "$value": "#f5f3ff" },
      "sidebarRing": { "$value": "#c084fc" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Ash", "Segoe UI", "sans-serif"],
        "$description": "Uses the supplied Ash font with Segoe UI and system sans-serif fallbacks."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Cascadia Code", "Consolas", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "12px base radius mapped from the ModernCard control."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "4px base rhythm, used to build the source app's compact desktop spacing."
    }
  }
}
